configuration {
    modi: "drun";
    show-icons: false;
    font: "JetBrains Mono 11";
}

* {
    background: #111111;
    foreground: #E6E6E6;

    normal-foreground: #E6E6E6;
    alternate-normal-foreground: #E6E6E6;

    selected-normal-foreground: #FFFFFF;
    selected-active-foreground: #FFFFFF;
    selected-urgent-foreground: #FFFFFF;

    border-color: #2A2A2A;
}

window {
    width: 500px;
    padding: 14px;
    border: 1px;
    border-color: #2A2A2A;
}

mainbox {
    children: [inputbar, listview];
    spacing: 10px;
}

inputbar {
    children: [entry];
}

entry {
    placeholder: "Search";
    placeholder-color: #666666;
    text-color: #E6E6E6;
}

listview {
    lines: 6;
    spacing: 2px;
}

element {
    padding: 7px;
}

element normal {
    background: #111111;
    text-color: #E6E6E6;
}

element alternate {
    background: #111111;
    text-color: #E6E6E6;
}

element selected {
    background: #2A2A2A;
    text-color: #FFFFFF;
}

element normal.normal {
    background: #111111;
    text-color: #E6E6E6;
}

element alternate.normal {
    background: #111111;
    text-color: #E6E6E6;
}

element selected.normal {
    background: #2A2A2A;
    text-color: #FFFFFF;
}

element-text {
    text-color: #E6E6E6;
}

element-text selected {
    text-color: #FFFFFF;
}
