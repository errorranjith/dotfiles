configuration {
    modi: "drun";
    show-icons: false;
    font: "monospace 10";
}

* {
    background-color: #1e1e2e;
    text-color: #cdd6f4;
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 30%;
    border: 1px;
    border-color: #89b4fa;
    padding: 10px;
}

element {
    padding: 5px;
}

element selected {
    background-color: #45475a;
    text-color: #f5e0dc;
}
