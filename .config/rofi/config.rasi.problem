configuration {
    modi: "drun";
    show-icons: false;
    font: "JetBrains Mono 11";
}

* {
    background: #111111;
    foreground: #E6E6E6;
    normal-foreground: #E6E6E6;
    alternate-normal-foreground: #E6E6E6;
    selected-normal-foreground: #FFFFFF;
}

window {
    width: 500px;
    padding: 14px;
}

mainbox {
    children: [inputbar, listview];
    spacing: 10px;
}

inputbar {
    children: [entry];
}

entry {
    placeholder: "Search";
    placeholder-color: #666666;
}

listview {
    lines: 6;
    spacing: 2px;
}

element {
    padding: 7px;
}

element normal {
    background: #111111;
    text-color: #E6E6E6;
}

element alternate {
    background: #111111;
    text-color: #E6E6E6;
}

element selected {
    background: #2A2A2A;
    text-color: #FFFFFF;
}
