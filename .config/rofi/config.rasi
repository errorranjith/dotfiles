configuration {
    modi: "drun";
    font: "JetBrains Mono 10";
    show-icons: false;
    display-drun: ">";
}

* {
    background-color: transparent;
    text-color: #ffffff;
    margin: 0;
    padding: 0;
}

window {
    location: center;
    anchor: center;
    width: 360px;
    background-color: #000000;
    border: 1px solid;
    border-color: #ffffff;
    padding: 12px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: #111111;
    padding: 8px 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: #ffffff;
    margin: 0px 8px 0px 0px;
}

entry {
    placeholder: "run...";
    placeholder-color: #555555;
    text-color: #ffffff;
}

listview {
    lines: 5;
    cycle: true;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 6px 10px;
}

element selected {
    background-color: #ffffff;
    text-color: #000000;
}

element-text {
    text-color: inherit;
}
