# ==============================================================================
# Automatic Floating Rules
# ==============================================================================
# Utility dialogs & system tools
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="Preferences"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable

# Audio, network, and hardware dialogs
for_window [class="Pavucontrol"] floating enable, resize set 650 450, move position center
for_window [class="Nm-connection-editor"] floating enable, resize set 600 400, move position center
for_window [class="Blueman-manager"] floating enable, resize set 600 400, move position center

# Media, calculators, and image viewers
for_window [class="feh"] floating enable
for_window [class="(?i)gnome-calculator"] floating enable
for_window [class="flameshot"] floating enable

# Center floating windows by default
for_window [floating] move position center

# Bottles management GUI and Wine configuration dialogues
for_window [class="com.usebottles.bottles"] floating enable, border pixel 2, resize set 1050 680, move position center
for_window [instance="wine"] floating enable

# FZF Scratchpad Launcher
for_window [instance="fzf_launcher"] floating enable, border pixel 2, resize set 520 280, move position center

# CopyQ Floating HUD Rule
for_window [class="copyq"] floating enable, border pixel 2, resize set 600 450, move position center

# Force 2px border on Kitty windows explicitly
for_window [class="kitty"] border pixel 2
for_window [class=".*"] border pixel 2
