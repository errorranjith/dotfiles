{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "white",
      "title": "white"
    },
    "key": {
      "width": 12
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "─────────────"
    },
    {
      "type": "os",
      "key": "󰌽  os"
    },
    {
      "type": "kernel",
      "key": "󰌽  kernel"
    },
    {
      "type": "wm",
      "key": "󱂬  wm"
    },
    {
      "type": "terminal",
      "key": "󰞷  term"
    },
    {
      "type": "shell",
      "key": "󰞷  shell"
    },
    {
      "type": "uptime",
      "key": "󰅐  uptime"
    },
    {
      "type": "packages",
      "key": "󰏖  pkgs"
    },
    {
      "type": "memory",
      "key": "󰍛  memory"
    },
    {
      "type": "custom",
      "format": "─────────────"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "block": {
        "range": [0, 7]
      }
    }
  ]
}
