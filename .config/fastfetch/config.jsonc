{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "white",
      "2": "white"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "white",
      "title": "white"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "os  "
    },
    {
      "type": "kernel",
      "key": "krn "
    },
    {
      "type": "uptime",
      "key": "up  "
    },
    {
      "type": "packages",
      "key": "pkg "
    },
    {
      "type": "memory",
      "key": "ram "
    }
  ]
}
