[global]
    width = (500, 360)
    height =90
    offset =16x16
    origin = top-right
    corner_radius = 10
    frame_width = 2
    frame_color = "#262626"
    font = Ubuntu Regular 10
    format = "<b>%s</b>\n%b"
    background = "#000000"
    foreground = "#ffffff"
    timeout = 4

[urgency_normal]
    frame_color = "#ffffff"

[urgency_critical]
    frame_color = "#ffffff"
    background = "#0d0d0d"
